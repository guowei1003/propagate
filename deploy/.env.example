# ============================
# 部署配置
# ============================

# 源码根目录（构建 context 所需）
# 示例：/root/propagate
ROOT_DIR=/root/propagate

# ============================
# 数据库
# ============================
POSTGRES_PASSWORD=postgres

# ============================
# LLM 配置
# ============================
# 可选值: demo | openai | ollama
LLM_PROVIDER=demo

# OpenAI 或 Ollama 的 API 地址
# 示例: https://api.openai.com/v1
# 示例: http://localhost:11434/v1
LLM_API_BASE=

# API 密钥
LLM_API_KEY=

# 模型名称
LLM_MODEL=gpt-4o-mini

# ============================
# Worker 配置
# ============================
# 最大并行任务数
WORKER_CONCURRENCY=3

# ============================
# Docker 网络
# ============================
DOCKER_NETWORK=propagate-net

# Sandbox 容器镜像（需提前 build）
RUNNER_IMAGE=propagate-runner:latest
