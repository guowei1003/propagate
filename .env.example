# Propagate Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Application Settings
# ===========================================

# Application name
APP_NAME=Propagate

# PostgreSQL connection string for V2
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/propagate

# Secret key for session/cookie signing (change in production!)
SECRET_KEY=propagate-dev

# Default model for demo mode (used when LLM_PROVIDER_TYPE=demo)
DEFAULT_MODEL=demo-heuristic

# Default timeout for operations (seconds)
DEFAULT_TIMEOUT_SEC=300

# ===========================================
# Worker Settings
# ===========================================

# Interval between worker polling cycles (seconds)
WORKER_POLL_INTERVAL_SEC=1.0

# Maximum number of concurrent worker threads
MAX_WORKER_CONCURRENCY=3

# Event streaming interval (seconds)
EVENT_STREAM_INTERVAL_SEC=1.0

# ===========================================
# LLM Provider Configuration
# ===========================================

# Provider type: "demo" (mock responses) or "openai_compatible"
LLM_PROVIDER_TYPE=demo

# API base URL (required for openai_compatible)
# Examples:
#   - OpenAI: https://api.openai.com/v1
#   - Azure OpenAI: https://your-resource.openai.azure.com/openai/deployments/your-deployment
#   - Local (Ollama): http://localhost:11434/v1
#   - Other OpenAI-compatible APIs
LLM_API_BASE_URL=

# API key (required for openai_compatible)
LLM_API_KEY=

# Default model name
LLM_DEFAULT_MODEL=gpt-4o-mini

# Model for code review tasks (falls back to LLM_DEFAULT_MODEL if empty)
LLM_REVIEW_MODEL=

# Model for test/validation tasks (falls back to LLM_DEFAULT_MODEL if empty)
LLM_TEST_MODEL=

# Model for capability generation (falls back to LLM_DEFAULT_MODEL if empty)
LLM_CAPABILITY_GENERATION_MODEL=

# Model for final report generation (falls back to LLM_DEFAULT_MODEL if empty)
LLM_REPORT_MODEL=

# Temperature for LLM responses (0.0 - 2.0)
LLM_TEMPERATURE=0.2

# Maximum retry attempts for LLM calls
LLM_MAX_RETRIES=2

# Timeout for LLM API calls (seconds)
LLM_TIMEOUT_SEC=300

# ===========================================
# Example: OpenAI Configuration
# ===========================================
# LLM_PROVIDER_TYPE=openai_compatible
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-api-key
# LLM_DEFAULT_MODEL=gpt-4o-mini
# LLM_REVIEW_MODEL=gpt-4o
# LLM_TEST_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.2

# ===========================================
# Example: Azure OpenAI Configuration
# ===========================================
# LLM_PROVIDER_TYPE=openai_compatible
# LLM_API_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment
# LLM_API_KEY=your-azure-api-key
# LLM_DEFAULT_MODEL=gpt-4

# ===========================================
# Example: Local Ollama Configuration
# ===========================================
# LLM_PROVIDER_TYPE=openai_compatible
# LLM_API_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_DEFAULT_MODEL=llama3
# LLM_TEMPERATURE=0.7

# ===========================================
# Example: Other OpenAI-Compatible APIs
# ===========================================
# LLM_PROVIDER_TYPE=openai_compatible
# LLM_API_BASE_URL=https://your-api-endpoint/v1
# LLM_API_KEY=your-api-key
# LLM_DEFAULT_MODEL=your-model-name
